version 0.1

activity DeclareBeforeDecision phase=BEFORE input=decision output=before_state
activity GenerateBeforeEvaluator phase=BEFORE input=semantic_ir output=generated_evaluator
activity DetectBeforeCounterexample phase=BEFORE input=unknown_decision output=before_refutation
activity PreserveBeforeRefutation phase=BEFORE input=counterexample output=append_only_history
activity DeclareCandidatePatch phase=BEFORE input=refutation output=candidate
activity IndependentlyEvaluateCandidate phase=BEFORE input=candidate output=independent_evaluation
